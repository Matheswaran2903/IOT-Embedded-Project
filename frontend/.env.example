# Optional: real e-mail notifications via EmailJS (https://www.emailjs.com) - no server needed.
# Template variables to create in EmailJS: {{to_email}}  {{subject}}  {{message}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# MERN backend address (see ../server). Used by src/services/api.ts
VITE_API_URL=http://localhost:8000
