# Copy to .env and edit. Never commit the real .env file.
PORT=8000
# Local MongoDB, or a MongoDB Atlas string: mongodb+srv://USER:PASS@cluster.mongodb.net/iot_explorer
MONGODB_URI=mongodb://127.0.0.1:27017/iot_explorer
UPLOAD_DIR=./uploads
# Frontend origins allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIMEZONE=Asia/Kolkata

# Judge / admin PIN. Admin endpoints are DISABLED while this is empty. Use a long random value.
JUDGE_PIN=

# Max students per presentation slot
SLOT_CAPACITY=5
MEETING_LINK=https://meet.google.com/your-event-room

# Optional: real e-mail through any SMTP server (Gmail needs an App Password).
# Without these, e-mails are only recorded in the mailoutboxes collection (status = simulated).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
